{
  "manifest_version": 3,
  "name": "SignalCheck - AI Trust Verification",
  "version": "1.0.0",
  "description": "Detect AI-generated content and verify domain reputation with one click.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://trustsignalcheck.onrender.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "SignalCheck - Verify Trust",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
